# 한국투자증권 Open API 설정
# https://apiportal.koreainvestment.com 에서 발급

# APP Key & Secret (한국투자증권 API 포털에서 발급)
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here

# 계좌번호 (8자리-2자리)
KIS_ACCOUNT_NO=12345678-01

# 모의투자 여부 (true: 모의투자, false: 실전투자)
# ⚠ 안전을 위해 기본값은 모의투자입니다. 실전투자 전환 시 false로 변경하세요.
KIS_MOCK=true

# 매매 설정
# 시작 자본금 (원) — 총 손익 계산의 기준
INITIAL_CAPITAL=100000

# 1회 최대 매수 금액 (원) — INITIAL_CAPITAL / MAX_HOLD_COUNT 기준
# 100,000원 자본 + 2종목 집중 = 50,000원/종목이 수학적 상한
MAX_BUY_AMOUNT=50000

# 최대 보유 종목 수 (v4.3: 소액은 2종목 집중 투자 권장)
# 자본 대비 너무 크게 잡으면 종목당 배분이 쪼개져 수수료/슬리피지에 먹힘
MAX_HOLD_COUNT=2

# 손절 비율 (%) — v4.7: 논지 기반 매도가 1차, 하드 손절은 극단 낙폭 안전망
# ⚠ -2.5로 낮추면 논지 체크 발동 전에 하드 손절이 먼저 터져 v4.7 설계가 무력화됨
STOP_LOSS_PCT=-4.0

# 익절 비율 (%) — 작은 수익 자주 확정
TAKE_PROFIT_PCT=1.5

# 매매 시작/종료 시간 (HH:MM)
TRADING_START_TIME=09:05
TRADING_END_TIME=15:10

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 네이버 검색 API (뉴스 감성 분석용, 선택사항)
# https://developers.naver.com 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
