# 한국투자증권 Open API 설정
# https://apiportal.koreainvestment.com 에서 발급

# APP Key & Secret (한국투자증권 API 포털에서 발급)
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here

# 계좌번호 (8자리-2자리)
KIS_ACCOUNT_NO=12345678-01

# 모의투자 여부 (true: 모의투자, false: 실전투자)
KIS_MOCK=false

# 매매 설정
# 1회 최대 매수 금액 (원)
MAX_BUY_AMOUNT=500000

# 최대 보유 종목 수
MAX_HOLD_COUNT=5

# 손절 비율 (%)
STOP_LOSS_PCT=-2.0

# 익절 비율 (%)
TAKE_PROFIT_PCT=3.0

# 매매 시작/종료 시간 (HH:MM)
TRADING_START_TIME=09:05
TRADING_END_TIME=15:10

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 네이버 검색 API (뉴스 감성 분석용, 선택사항)
# https://developers.naver.com 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
